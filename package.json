{
  "name": "cue",
  "version": "0.1.17",
  "description": "Open-source cross-platform AI overlay with screen, microphone, and system-audio input.",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/endpoints.test.js test/recap-export.test.js test/session-journal.test.js test/meeting-tools.test.js test/local-stt.test.js test/transcript.test.js test/window-layout.test.js",
    "test:ui": "electron test/ui-smoke.js",
    "pack": "electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "electron-builder --mac zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win",
    "test:behavior": "electron test/panel-behavior.js",
    "test:assistant": "electron test/assistant-flow.js"
  },
  "build": {
    "appId": "com.cue.overlay",
    "productName": "cue",
    "asar": true,
    "asarUnpack": [
      "src/local-stt/*.py"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "!src/**/__pycache__/**"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "cue transcribes your microphone so it can help you in conversations.",
        "NSCameraUsageDescription": "cue does not use the camera.",
        "NSAudioCaptureUsageDescription": "cue captures system audio to transcribe the other participant in a call."
      }
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "screen-capture",
    "macos",
    "windows"
  ],
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "docx": "^9.7.1",
    "lucide-static": "^0.468.0",
    "openai": "^4.73.0",
    "pdfkit": "^0.17.2"
  }
}
